{
  "name": "product-platform-kit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "node scripts/check-repository.mjs",
    "check:operating-model": "node scripts/check-operating-model.mjs",
