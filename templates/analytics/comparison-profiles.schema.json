{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact-alias multiplicative comparability profiles",
  "description": "Starter structural contract; providers must additionally validate regex safety, unique identifiers, dimensional consistency, admission and domain-specific thresholds. Extensions remain provider-owned.",
  "type": "object",
  "required": [
    "version",
    "profiles"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "revision",
          "status",
          "label",
          "matcher",
          "specification_aliases",
          "attributes",
          "normalized_unit",
          "unit_rules",
          "missing_specification_policy",
          "missing_unit_policy",
          "temporal_basis",
          "review",
          "statistics_policy",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "draft",
              "local_candidate",
              "independently_reviewed",
              "retired"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "matcher": {
            "const": "canonical_exact_alias"
          },
          "specification_aliases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "attributes": {
            "type": "object",
            "minProperties": 1
          },
          "normalized_unit": {
            "type": "string",
            "minLength": 1
          },
          "unit_rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "pattern",
                "multiplier",
                "count_kind"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "pattern": {
                  "type": "string",
                  "minLength": 1
                },
                "multiplier": {
                  "type": "string",
                  "pattern": "^(?:0\\.\\d*[1-9]\\d*|[1-9]\\d*(?:\\.\\d+)?)$"
                },
                "count_kind": {
                  "enum": [
                    "integer",
                    "continuous"
                  ]
                }
              }
            }
          },
          "missing_specification_policy": {
            "const": "exclude"
          },
          "missing_unit_policy": {
            "const": "exclude"
          },
          "temporal_basis": {
            "type": "string",
            "minLength": 1
          },
          "review": {
            "type": "object",
            "required": [
              "status",
              "authority",
              "evidence"
            ],
            "properties": {
              "status": {
                "type": "string",
                "minLength": 1
              },
              "authority": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "statistics_policy": {
            "type": "object",
            "required": [
              "min_peer_observations",
              "min_peer_entities",
              "iqr_multiplier"
            ],
            "properties": {
              "min_peer_observations": {
                "type": "integer",
                "minimum": 1
              },
              "min_peer_entities": {
                "type": "integer",
                "minimum": 1
              },
              "iqr_multiplier": {
                "type": "string",
                "pattern": "^(?:0\\.\\d*[1-9]\\d*|[1-9]\\d*(?:\\.\\d+)?)$"
              }
            }
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
