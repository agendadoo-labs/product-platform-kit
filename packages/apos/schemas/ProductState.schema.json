{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:apos:v0.1:ProductState",
  "title": "ProductState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "satisfied_intents",
    "evidence_ids",
    "artifact_digest"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "satisfied_intents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "artifact_digest": {
      "type": "string",
      "minLength": 1
    }
  }
}
