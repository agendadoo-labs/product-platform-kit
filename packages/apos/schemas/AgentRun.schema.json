{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:apos:v0.1:AgentRun",
  "title": "AgentRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "intent_id",
    "status",
    "capability",
    "input_digest",
    "base_revision",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "intent_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "blocked"
      ]
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "input_digest": {
      "type": "string",
      "minLength": 1
    },
    "base_revision": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
