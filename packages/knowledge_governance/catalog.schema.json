{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:apos:knowledge-governance:catalog:2",
  "title": "Knowledge governance catalog v1/v2",
  "type": "object",
  "required": [
    "schema_version",
    "documents",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "revision",
          "sha256",
          "graph_scope",
          "lifecycle",
          "owner",
          "purpose",
          "read_when",
          "classification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "graph_scope": {
            "enum": [
              "vigente",
              "historico",
              "candidato",
              "referencia"
            ]
          },
          "lifecycle": {
            "enum": [
              "draft",
              "approved",
              "superseded",
              "retired"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "read_when": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "classification": {
            "enum": [
              "public",
              "internal",
              "restricted"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "revision"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "specification",
          "acceptance",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "specification": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "planned",
              "implemented",
              "verified"
            ]
          }
        }
      }
    },
    "current_state_ref": {
      "type": "object",
      "required": [
        "path",
        "keys"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "state_projections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "current_state_ref",
          "state_projections"
        ],
        "not": {
          "required": [
            "current_state"
          ]
        },
        "properties": {
          "requirements": {
            "items": {
              "if": {
                "properties": {
                  "status": {
                    "const": "verified"
                  }
                }
              },
              "then": {
                "required": [
                  "evidence"
                ],
                "properties": {
                  "evidence": {
                    "type": "object",
                    "required": [
                      "dependency_fingerprint"
                    ],
                    "properties": {
                      "dependency_fingerprint": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
