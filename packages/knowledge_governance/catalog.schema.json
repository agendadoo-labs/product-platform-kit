{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:apos:knowledge-governance:catalog:1",
  "title": "Knowledge governance catalog v1",
  "type": "object",
  "required": [
    "schema_version",
    "documents",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "revision",
          "sha256",
          "graph_scope",
          "lifecycle",
          "owner",
          "purpose",
          "read_when",
          "classification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "graph_scope": {
            "enum": [
              "vigente",
              "historico",
              "candidato",
              "referencia"
            ]
          },
          "lifecycle": {
            "enum": [
              "draft",
              "approved",
              "superseded",
              "retired"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "read_when": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "classification": {
            "enum": [
              "public",
              "internal",
              "restricted"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "revision"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "specification",
          "acceptance",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "specification": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "planned",
              "implemented",
              "verified"
            ]
          }
        }
      }
    }
  }
}
